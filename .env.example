# Recommended: monitor through Bambu Cloud. Run `npm run bridge:setup:cloud`
# and the setup tool will fill these values in .env.local.
BAMBU_CONNECTION_MODE=cloud
BAMBU_CLOUD_REGION=global
BAMBU_CLOUD_USER_ID=
BAMBU_CLOUD_ACCESS_TOKEN=
BAMBU_SERIAL=

# Optional LAN fallback. Keep these values on the bridge machine only.
BAMBU_HOST=192.168.1.123
BAMBU_ACCESS_CODE=
BRIDGE_PORT=8789

# Optional: publish sanitized printer status to the public Cloudflare site.
COINPRINT_STATUS_URL=https://jock-jai-p1s.mokyeung08.workers.dev/api/printer
COINPRINT_BRIDGE_TOKEN=

# Public project URL plus server-only service-role key for the shared queue.
SUPABASE_URL=https://illnzklyhohxpggqwzqo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
